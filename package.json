{
  "name": "feedme",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "node esbuild.config.mjs && node scripts/package.mjs",
    "release": "node scripts/release.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test": "jest"
  },
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "dependencies": {
    "fuse.js": "^7.0.0",
    "webextension-polyfill": "^0.10.0"
  },
  "devDependencies": {
    "esbuild": "^0.21.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "markdown-it": "^15.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
